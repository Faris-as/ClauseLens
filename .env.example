# ==============================================================================
# ClauseLens Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=ClauseLens
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-secure-random-string-min-32-chars
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=clauselens
POSTGRES_PASSWORD=clauselens_secret
POSTGRES_DB=clauselens_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clauselens:clauselens_secret@postgres:5432/clauselens_db

# Redis & Background Jobs (RQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES_LIMIT=200

# LLM Provider — IFM API (Institute of Foundation Models / MBZUAI)
# IFM endpoints adhere to OpenAI-compatible REST specifications.
IFM_API_KEY=your_ifm_api_key_here
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=k2-horizon-large
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60

# OCR Engine
OCR_PRIMARY_ENGINE=easyocr
OCR_LANGUAGES=ar,en
OCR_GPU_ENABLED=false

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
